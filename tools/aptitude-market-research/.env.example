# ============================================================
#  Aptitude Market Research Kit — credentials
#  Copy to .env and fill in. Modules with missing keys are skipped.
# ============================================================

# --- KEYWORD RESEARCH (core) ---------------------------------
# DataForSEO — real volumes, difficulty, SERP. Pay-as-you-go.
# https://dataforseo.com  (Dashboard → API access)
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=

# --- DEMAND: JOB MARKET --------------------------------------
# Adzuna — graduate hiring volume by country/sector. Free tier.
# https://developer.adzuna.com
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# --- VOICE OF CUSTOMER ---------------------------------------
# Reddit — candidate pain-point mining. Free. App type: "script".
# https://www.reddit.com/prefs/apps
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=aptitude-research by /u/yourusername

# --- COMPETITOR TRAFFIC --------------------------------------
# Similarweb — incumbent traffic + geo + sources. Paid/API plan.
# https://www.similarweb.com  (Account → API)
SIMILARWEB_API_KEY=

# --- FUNDING / GRAVEYARD -------------------------------------
# Crunchbase — who raised / exited / died in this space. Paid plan.
# https://data.crunchbase.com
CRUNCHBASE_API_KEY=

# --- OPTIONAL SWAP-INS ---------------------------------------
# Use instead of / alongside DataForSEO if you already pay for these.
SEMRUSH_API_KEY=
AHREFS_API_TOKEN=
# Google Trends (pytrends) needs NO key.
